# Deyno Pro — full-service restaurant POS (dine-in, tables, KOT).
#
# Where the Vite dev server forwards /api. Point at a local API
# (http://localhost:5010) or the hosted one. Dev only.
VITE_API_PROXY_TARGET=https://api.moifone.com

# Overrides the API base the app calls at runtime. Leave unset in dev so
# requests go to same-origin /api and ride the proxy above. Required for the
# packaged Electron build, which has no dev proxy:
#   VITE_API_BASE=https://api.moifone.com/api
# VITE_API_BASE=
