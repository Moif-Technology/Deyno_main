{
  "name": "deyno-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:api": "node scripts/check-api.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:5180 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "lucide-react": "^1.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.moifone.deynopro",
    "productName": "Deyno Pro",
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis" }
  }
}
